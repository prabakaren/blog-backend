# MongoDB Atlas connection string (replace user, password and cluster)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/blogDB?retryWrites=true&w=majority

# Firebase Admin credentials (Firebase console > Project settings > Service accounts > Generate new private key)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Comma separated list of emails that are allowed into the admin panel
ADMIN_EMAILS=you@example.com

# Frontend URL(s) allowed to call this API (comma separated). Leave empty to allow all in development.
CLIENT_URL=http://localhost:3000

PORT=5000
